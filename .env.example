# Public app URL
APP_URL="https://your-domain.example"

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority"

# Generate a strong secret, for example: openssl rand -base64 64
JWT_SECRET="replace-with-a-random-production-secret"

# Resend transactional email service
# Obtain a key from https://resend.com/api-keys
RESEND_API_KEY="replace-with-your-resend-api-key"
EMAIL_FROM="BookHaven <onboarding@resend.dev>"

# Optional AI integration
GEMINI_API_KEY=""

# Server port
PORT=3000

# Optional frontend API origin. Leave empty to use the Vite development proxy.
VITE_API_BASE_URL=""
